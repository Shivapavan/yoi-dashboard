SHIFT4_SECRET_KEY=sk_live_your_secret_key_here
LIGHTHOUSE_TOKEN=your_lighthouse_jwt_token_here
LIGHTHOUSE_LOCATION_ID=your_location_id_here
LIGHTHOUSE_MERCHANT_ID=your_merchant_id_here
EDGE_CONFIG_ID=your_edge_config_id_here
VERCEL_TEAM_ID=your_vercel_team_id_here
NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app

# Events Space — secret slug embedded in the public booking URL.
# Anyone with /events/<slug> can view + edit bookings without logging in.
# Use 24+ random characters (e.g. `uuidgen` or `openssl rand -hex 16`).
EVENTS_PUBLIC_SLUG=replace_with_long_random_string

# Table Reservation Bot — Anthropic API key for Claude Haiku (server-side only, never expose to browser)
ANTHROPIC_API_KEY=
